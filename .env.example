# Local Compose only. Railway generates every secret itself; the deployer
# supplies just FORMBRICKS_OWNER_EMAIL. Use `openssl rand -hex 24` for the
# passwords and `openssl rand -hex 32` for the keys.
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
SPICEDB_DATABASE_PASSWORD=replace-with-openssl-rand-hex-24
VALKEY_PASSWORD=replace-with-openssl-rand-hex-24
SPICEDB_GRPC_PRESHARED_KEY=replace-with-openssl-rand-hex-32
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32
ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
CRON_SECRET=replace-with-openssl-rand-hex-32
HUB_API_KEY=replace-with-openssl-rand-hex-32
CUBEJS_API_SECRET=replace-with-openssl-rand-hex-32
# The owner account Formbricks creates at first start (scripts/smoke.sh signs in with it).
FORMBRICKS_OWNER_EMAIL=you@example.com
# 16 to 128 letters and digits with at least one capital letter and one digit.
FORMBRICKS_OWNER_PASSWORD=Fb7ReplaceWithOpensslRandHex16
